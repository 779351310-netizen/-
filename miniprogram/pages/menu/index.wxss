.menu-heading { display:flex; align-items:center; justify-content:space-between; gap:14rpx; }
.menu-heading .title { margin-top:6rpx; }
.add-dish { flex-shrink:0; min-height:68rpx; font-size:23rpx; }
.category-scroll { margin:24rpx -30rpx 18rpx; white-space:nowrap; }
.category-row { display:inline-flex; gap:12rpx; padding:0 30rpx; }
.category { padding:16rpx 25rpx; border-radius:34rpx; background:#fff; color:#987c77; font-size:24rpx; }
.category.active { background:#f47e8e; color:#fff; font-weight:700; }
.dish-list { display:flex; flex-direction:column; gap:18rpx; }
.dish-card { display:flex; gap:18rpx; padding:16rpx; border-radius:30rpx; background:#fff; box-shadow:0 10rpx 28rpx rgba(174,119,111,.07); }
.dish-photo { flex-shrink:0; width:186rpx; height:190rpx; border-radius:24rpx; background:#fff1ee; }
.photo-empty { display:flex; align-items:center; justify-content:center; font-size:58rpx; }
.dish-copy { display:flex; flex:1; min-width:0; flex-direction:column; padding:4rpx 4rpx 2rpx 0; }
.dish-title-row { align-items:flex-start; gap:8rpx; }
.dish-name { max-width:330rpx; font-size:29rpx; font-weight:750; line-height:1.35; }
.status-pill { flex-shrink:0; padding:7rpx 14rpx; font-size:19rpx; }
.dish-meta { margin-top:8rpx; color:#aa8d87; font-size:21rpx; }
.dish-description { display:-webkit-box; margin-top:8rpx; overflow:hidden; color:#785e58; font-size:22rpx; line-height:1.4; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.dish-bottom { margin-top:auto; padding-top:10rpx; }
.time-pill { padding:8rpx 14rpx; border-radius:24rpx; background:#fff5e8; color:#af8663; font-size:20rpx; }
.add-btn { padding:10rpx 18rpx; border-radius:28rpx; background:#fff0f1; color:#d56e7a; font-size:21rpx; font-weight:700; }
.icon-btn { display:flex; align-items:center; justify-content:center; width:56rpx; height:48rpx; border-radius:25rpx; background:#fff0f1; color:#cf7180; font-size:26rpx; }
.empty-card { text-align:center; }
.empty-emoji { display:block; margin-bottom:16rpx; font-size:58rpx; }
.empty-button { width:70%; margin:25rpx auto 0; }
.cart-note { padding:12rpx 0 4rpx; }
.note-field { margin-top:12rpx; }
.cart-bar { position:sticky; bottom:0; z-index:4; display:flex; align-items:center; justify-content:space-between; margin:18rpx -30rpx -48rpx; padding:20rpx 30rpx 34rpx; border-top:1rpx solid #f5e7e4; background:rgba(255,253,252,.96); }
.cart-count { color:#ef7586; font-size:38rpx; font-weight:800; }
.cart-label { color:#9b7b76; font-size:22rpx; }
.checkout-btn { min-height:76rpx; font-size:24rpx; }
